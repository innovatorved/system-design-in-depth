{
  "name": "system-design-in-depth",
  "version": "1.0.0",
  "description": "Open-source interactive platform for learning system design, storage engines, and distributed systems engineering with 32 visual simulators and 20 browser-native build labs.",
  "homepage": "https://system-design-in-depth.vedgupta.in",
  "scripts": {
    "build": "node tools/build.js",
    "validate": "node tools/validate.js",
    "check:rendered": "node tools/check-rendered.js",
    "test": "node tools/validate.js && node tools/check-rendered.js",
    "e2e": "node tests/e2e/run-all.js",
    "stamp": "node tools/stamp-assets.js",
    "stamp:check": "node tools/stamp-assets.js --check",
    "prerender": "node tools/generate-static.js",
    "og": "node tools/generate-og.js",
    "serve": "python3 -m http.server 8000"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/innovatorved/system-design-in-depth.git"
  },
  "bugs": {
    "url": "https://github.com/innovatorved/system-design-in-depth/issues"
  },
  "keywords": [
    "system-design",
    "distributed-systems",
    "storage-engines",
    "consensus",
    "interactive-simulators",
    "code-lab"
  ],
  "author": "Ved Gupta (https://vedgupta.in)",
  "license": "MIT AND CC-BY-4.0",
  "dependencies": {
    "@innovatorved/code-lab": "^0.6.1"
  }
}
