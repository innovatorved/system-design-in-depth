{
  "name": "system-design-in-depth",
  "version": "1.0.0",
  "description": "System Design In Depth — An interactive, primary-source curriculum and coding lab platform for distributed systems engineering.",
  "private": true,
  "scripts": {
    "build": "node tools/build.js",
    "validate": "node tools/validate.js",
    "check:rendered": "node tools/check-rendered.js",
