{
  "name": "@innovatorved/code-lab",
  "version": "1.3.0",
  "description": "Standalone browser-native IDE Workbench, POSIX Shell & Coreutils, PTY Terminal, and Web Worker Node.js/Bun Virtual Runtime.",
  "main": "./dist/code-lab.js",
  "module": "./dist/code-lab.esm.js",
  "types": "./dist/code-lab.d.ts",
  "style": "./dist/code-lab.css",
  "exports": {
    ".": {
      "types": "./dist/code-lab.d.ts",
      "import": "./dist/code-lab.esm.js",
      "require": "./dist/code-lab.js",
      "default": "./dist/code-lab.js"
    },
    "./runtime": {
      "import": "./dist/runtime.esm.js",
      "require": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./shell": {
      "import": "./dist/shell.esm.js",
      "require": "./dist/shell.js",
      "default": "./dist/shell.js"
    },
    "./terminal": {
      "import": "./dist/terminal.esm.js",
      "require": "./dist/terminal.js",
      "default": "./dist/terminal.js"
    },
    "./code-lab.css": "./dist/code-lab.css",
    "./dist/code-lab.css": "./dist/code-lab.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "wiki"
  ],
  "scripts": {
    "build": "node tools/bundle.js",
    "test": "node test-all-builds.js",
    "test:all": "node test-all-builds.js && node test-runtime-advanced.js && node test-option1-shell-bun-http.js && node test-coreutils-adversarial.js && node test-stress-shell.js && node test-workbench-ui.js",
    "pack:check": "npm pack --dry-run",
    "wiki:push": "node tools/push-wiki.js"
  },
  "keywords": [
    "ide",
    "code-playground",
    "monaco-editor",
    "virtual-runtime",
    "web-component",
    "system-design",
    "browser-sandbox",
    "guided-labs"
  ],
  "author": "Ved Gupta",
  "license": "MIT"
}
